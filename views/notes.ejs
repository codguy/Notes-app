<%
  // Notes list: shows the board or the timeline depending on the saved view preference.
  // Expects: notes, prefs, searchTerm, activeTag, now, h
  const list = notes || [];
%>
<% if (list.length > 0) { %>
  <% if (prefs.view === 'timeline') { %>
    <%- include('timeline.ejs', { notes: list }) %>
  <% } else { %>
    <%- include('board.ejs', { notes: list }) %>
  <% } %>
<% } else if (searchTerm || activeTag) { %>
  <div class="text-center py-20">
    <p class="font-display text-2xl font-bold">
      <% if (searchTerm) { %>Nothing matches “<%= searchTerm %>”<% } else { %>No notes tagged #<%= activeTag %><% } %>
    </p>
    <p class="mt-2 text-slate">
      <% if (prefs.showArchived) { %>Try a shorter word or a different tag.<% } else { %>Try a shorter word, or turn on “Include archived” to search your archive too.<% } %>
    </p>
  </div>
<% } else { %>
  <div class="text-center py-20">
    <p class="font-display text-2xl font-bold">Your board is empty</p>
    <p class="mt-2 text-slate">Write your first note and it will appear here.</p>
    <button type="button" onclick="openCreate()" class="mt-6 inline-flex items-center gap-2 rounded-full bg-pen px-5 py-2.5 font-semibold text-white hover:bg-blue-700">
      New note
    </button>
  </div>
<% } %>
