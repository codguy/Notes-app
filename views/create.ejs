<form id="noteForm" action="/create" method="POST" class="space-y-5">
  <h2 id="noteFormHeading" class="font-display text-2xl font-bold">New note</h2>
  <div>
    <label for="title" class="block mb-1.5 text-sm font-semibold">Title</label>
    <input type="text" id="title" name="title" required maxlength="120" placeholder="Give it a short name"
      class="w-full px-3.5 py-2.5 bg-white border border-slate-300 rounded-lg placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-pen focus:border-transparent">
  </div>
  <div>
    <div class="flex items-end justify-between mb-1.5">
      <label for="content" class="block text-sm font-semibold">Note</label>
      <button type="button" id="addChecklistItem" class="inline-flex items-center gap-1 rounded-md px-2 py-1 text-xs font-semibold text-pen hover:bg-white">
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M5 4h14a1 1 0 011 1v14a1 1 0 01-1 1H5a1 1 0 01-1-1V5a1 1 0 011-1z" /></svg>
        Add checklist item
      </button>
    </div>
    <textarea id="content" name="content" rows="7" required placeholder="Write anything — lists, ideas, reminders…"
      class="w-full px-3.5 py-2.5 bg-white border border-slate-300 rounded-lg placeholder-slate-400 leading-relaxed focus:outline-none focus:ring-2 focus:ring-pen focus:border-transparent"></textarea>
    <p class="mt-1 text-xs text-slate">Start a line with <span class="font-mono">[ ]</span> to turn it into a tickable checkbox.</p>
  </div>
  <div>
    <label for="tags" class="block mb-1.5 text-sm font-semibold">Tags <span class="font-normal text-slate">(optional)</span></label>
    <input type="text" id="tags" name="tags" maxlength="200" placeholder="e.g. home, travel" autocomplete="off"
      class="w-full px-3.5 py-2.5 bg-white border border-slate-300 rounded-lg placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-pen focus:border-transparent">
    <p class="mt-1 text-xs text-slate">Separate tags with commas.</p>
  </div>
  <fieldset>
    <legend class="mb-2 text-sm font-semibold">Card colour</legend>
    <div class="flex gap-3">
      <% [['sky', '#D6E4F0'], ['sage', '#DCE8D3'], ['butter', '#F4E8C1'], ['rose', '#F2DAD6'], ['lilac', '#E3DDF0'], ['paper', '#FBFCFD']].forEach(function([name, hex], i) { %>
        <label class="swatch cursor-pointer" title="<%= name.charAt(0).toUpperCase() + name.slice(1) %>">
          <input type="radio" name="color" value="<%= name %>" class="sr-only" <%= i === 0 ? 'checked' : '' %>>
          <span class="block h-8 w-8 rounded-full border border-slate-300" style="background: <%= hex %>"></span>
          <span class="sr-only"><%= name %></span>
        </label>
      <% }); %>
    </div>
  </fieldset>
  <div class="flex justify-end gap-3 pt-2">
    <button type="button" data-close-modal class="px-4 py-2.5 rounded-lg font-semibold text-slate hover:bg-slate-100">Cancel</button>
    <button type="submit" id="noteFormSubmit" class="px-5 py-2.5 rounded-lg font-semibold bg-pen text-white hover:bg-blue-700">Save note</button>
  </div>
</form>
