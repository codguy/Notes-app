<% if (archived && archived.length > 0) { %>
  <ul class="space-y-3">
    <% archived.slice().sort((a, b) => b.id - a.id).forEach(function(note) { %>
      <li class="rounded-xl border border-slate-200 bg-white p-4">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <p class="font-display font-bold leading-snug"><%= note.title %></p>
            <p class="mt-1 text-sm text-slate line-clamp-2"><%= note.content %></p>
          </div>
          <button type="button" onclick="unarchiveNote('<%= note.id %>')"
            class="shrink-0 inline-flex items-center gap-1.5 rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-semibold hover:border-pen hover:text-pen">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6" /></svg>
            Restore
          </button>
        </div>
      </li>
    <% }); %>
  </ul>
<% } else { %>
  <div class="text-center py-16">
    <p class="font-display text-lg font-bold">Archive is empty</p>
    <p class="mt-1 text-sm text-slate">Archive a note to tuck it away without deleting it.</p>
  </div>
<% } %>
