<!DOCTYPE html>
<html lang="en" data-theme="light">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title><%= title %> - Notes App</title>
        <script>
            // Apply the saved theme before anything is drawn, so the page never flashes the wrong look.
            // "auto" (the default) follows the device's light/dark setting.
            (function () {
                var themes = ['light', 'dark', 'notebook', 'retro', 'terminal', 'blueprint', 'paperback'];
                var match = document.cookie.match(/(?:^|; )theme=([^;]*)/);
                var choice = match ? decodeURIComponent(match[1]) : 'auto';
                if (themes.indexOf(choice) < 0) choice = 'auto';
                var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
                var root = document.documentElement;
                root.setAttribute('data-theme', choice === 'auto' ? (prefersDark ? 'dark' : 'light') : choice);
                root.setAttribute('data-theme-choice', choice);
            })();
        </script>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Kalam:wght@400;700&family=Fraunces:opsz,wght,SOFT,WONK@9..144,600..900,0..100,0..1&family=VT323&family=Architects+Daughter&family=Literata:ital,opsz,wght@0,7..72,400..700;1,7..72,400..700&display=swap" rel="stylesheet" />
        <script src="https://cdn.tailwindcss.com"></script>
        <script>
            // Colours and fonts come from the active theme (see the theme blocks below)
            const themeColor = name => `rgb(var(--${name}) / <alpha-value>)`;
            tailwind.config = {
                theme: {
                    extend: {
                        fontFamily: {
                            display: ['var(--font-display)'],
                            sans: ['var(--font-body)'],
                            mono: ['var(--font-mono)'],
                        },
                        colors: {
                            desk: themeColor('desk'),
                            ink: themeColor('ink'),
                            // Adds `text-slate` (muted text) without replacing the built-in slate-100…900 shades
                            slate: { DEFAULT: themeColor('muted') },
                            pen: themeColor('pen'),
                            'on-pen': themeColor('on-pen'),
                            surface: themeColor('surface'),
                            line: themeColor('line'),
                        },
                    },
                },
            };
        </script>
        <style>
            /* ===================== Themes =====================
               Each theme sets: page colours (RGB triplets), fonts, and its six card colours
               (--t-* card background, --e-* card edge, --d-* strong accent used for dots and outlines). */

            [data-theme="light"] {
                --desk: 230 236 241; --ink: 27 42 58; --muted: 91 107 124; --pen: 47 91 234; --on-pen: 255 255 255;
                --surface: 255 255 255; --line: 203 213 225;
                --font-display: "Bricolage Grotesque", system-ui, sans-serif;
                --font-body: "Instrument Sans", system-ui, sans-serif;
                --font-mono: "JetBrains Mono", ui-monospace, monospace;
                --t-sky: #D6E4F0;    --e-sky: #A9C3DB;    --d-sky: #7FA6CB;
                --t-sage: #DCE8D3;   --e-sage: #AFC9A0;   --d-sage: #86AD72;
                --t-butter: #F4E8C1; --e-butter: #DDC680; --d-butter: #D2B04F;
                --t-rose: #F2DAD6;   --e-rose: #DDAAA2;   --d-rose: #D28A7F;
                --t-lilac: #E3DDF0;  --e-lilac: #B9ADD6;  --d-lilac: #9A8AC6;
                --t-paper: #FBFCFD;  --e-paper: #CDD6DF;  --d-paper: #A9B6C3;
                color-scheme: light;
            }

            [data-theme="dark"] {
                --desk: 17 21 27; --ink: 228 233 240; --muted: 148 160 178; --pen: 128 158 255; --on-pen: 12 18 36;
                --surface: 28 34 43; --line: 55 66 82;
                --font-display: "Bricolage Grotesque", system-ui, sans-serif;
                --font-body: "Instrument Sans", system-ui, sans-serif;
                --font-mono: "JetBrains Mono", ui-monospace, monospace;
                --t-sky: #1C2E42;    --e-sky: #2E4A68;    --d-sky: #6E9CCB;
                --t-sage: #1F3326;   --e-sage: #35523E;   --d-sage: #7DB36A;
                --t-butter: #36301F; --e-butter: #5A4D2B; --d-butter: #D9B54E;
                --t-rose: #3B2426;   --e-rose: #5E3A3B;   --d-rose: #DB8A80;
                --t-lilac: #2C2740;  --e-lilac: #4A3F68;  --d-lilac: #A493DB;
                --t-paper: #222932;  --e-paper: #3A4553;  --d-paper: #93A2B3;
                color-scheme: dark;
            }

            /* Notebook: lined pages on a kraft-paper cover */
            [data-theme="notebook"] {
                --desk: 205 178 136; --ink: 43 33 24; --muted: 82 62 40; --pen: 35 71 184; --on-pen: 255 255 255;
                --surface: 252 249 241; --line: 150 122 82;
                --font-display: "Kalam", "Comic Sans MS", cursive;
                --font-body: "Instrument Sans", system-ui, sans-serif;
                --font-mono: "JetBrains Mono", ui-monospace, monospace;
                --t-sky: #EEF4FA;    --e-sky: #B9CDE3;    --d-sky: #5C8FC7;
                --t-sage: #EEF5E9;   --e-sage: #BDD3AF;   --d-sage: #6FA65A;
                --t-butter: #FCF6DF; --e-butter: #E2D29A; --d-butter: #CDA733;
                --t-rose: #FBEDEA;   --e-rose: #E5BDB4;   --d-rose: #CF7565;
                --t-lilac: #F2EFF9;  --e-lilac: #CCC3E4;  --d-lilac: #8C79C9;
                --t-paper: #FFFFFF;  --e-paper: #D6D9DD;  --d-paper: #9AA6B2;
                color-scheme: light;
            }

            /* Retro: 70s mustard, orange and teal with bold outlines */
            [data-theme="retro"] {
                --desk: 244 228 193; --ink: 59 42 26; --muted: 112 82 54; --pen: 207 86 32; --on-pen: 255 246 227;
                --surface: 255 246 227; --line: 59 42 26;
                --font-display: "Fraunces", Georgia, serif;
                --font-body: "Instrument Sans", system-ui, sans-serif;
                --font-mono: "JetBrains Mono", ui-monospace, monospace;
                --t-sky: #8FCFC3;    --e-sky: #3B2A1A;    --d-sky: #2F8F80;
                --t-sage: #C3C96B;   --e-sage: #3B2A1A;   --d-sage: #7E8E22;
                --t-butter: #F4BE45; --e-butter: #3B2A1A; --d-butter: #E0A01C;
                --t-rose: #F39A6E;   --e-rose: #3B2A1A;   --d-rose: #D9622B;
                --t-lilac: #CFA9D9;  --e-lilac: #3B2A1A;  --d-lilac: #9C6BAE;
                --t-paper: #FFF6E3;  --e-paper: #3B2A1A;  --d-paper: #B89B72;
                color-scheme: light;
            }

            /* Terminal: glowing green on a black screen */
            [data-theme="terminal"] {
                --desk: 8 12 9; --ink: 110 255 150; --muted: 74 178 106; --pen: 255 184 0; --on-pen: 8 12 9;
                --surface: 14 24 17; --line: 38 92 52;
                --font-display: "VT323", "JetBrains Mono", monospace;
                --font-body: "JetBrains Mono", ui-monospace, monospace;
                --font-mono: "JetBrains Mono", ui-monospace, monospace;
                --t-sky: rgb(92 200 255 / 0.07);   --e-sky: #5CC8FF;    --d-sky: #5CC8FF;
                --t-sage: rgb(102 255 140 / 0.06); --e-sage: #66FF8C;   --d-sage: #66FF8C;
                --t-butter: rgb(255 216 74 / 0.07); --e-butter: #FFD84A; --d-butter: #FFD84A;
                --t-rose: rgb(255 107 139 / 0.08); --e-rose: #FF6B8B;   --d-rose: #FF6B8B;
                --t-lilac: rgb(199 146 255 / 0.08); --e-lilac: #C792FF; --d-lilac: #C792FF;
                --t-paper: rgb(207 232 213 / 0.05); --e-paper: #CFE8D5; --d-paper: #CFE8D5;
                color-scheme: dark;
            }

            /* Blueprint: white lines on drafting blue */
            [data-theme="blueprint"] {
                --desk: 25 68 132; --ink: 240 246 255; --muted: 178 202 236; --pen: 255 214 80; --on-pen: 18 44 88;
                --surface: 33 82 152; --line: 130 170 225;
                --font-display: "Architects Daughter", "Comic Sans MS", cursive;
                --font-body: "Instrument Sans", system-ui, sans-serif;
                --font-mono: "JetBrains Mono", ui-monospace, monospace;
                --t-sky: rgb(159 211 255 / 0.12);   --e-sky: rgb(255 255 255 / 0.75);    --d-sky: #9FD3FF;
                --t-sage: rgb(168 240 180 / 0.11);  --e-sage: rgb(255 255 255 / 0.75);   --d-sage: #A8F0B4;
                --t-butter: rgb(255 226 122 / 0.11); --e-butter: rgb(255 255 255 / 0.75); --d-butter: #FFE27A;
                --t-rose: rgb(255 179 179 / 0.11);  --e-rose: rgb(255 255 255 / 0.75);   --d-rose: #FFB3B3;
                --t-lilac: rgb(216 194 255 / 0.12); --e-lilac: rgb(255 255 255 / 0.75);  --d-lilac: #D8C2FF;
                --t-paper: rgb(255 255 255 / 0.07); --e-paper: rgb(255 255 255 / 0.75);  --d-paper: #FFFFFF;
                color-scheme: dark;
            }

            /* Paperback: soft sepia, like the pages of an old book */
            [data-theme="paperback"] {
                --desk: 233 220 196; --ink: 58 42 30; --muted: 112 90 70; --pen: 139 58 42; --on-pen: 248 240 224;
                --surface: 247 239 224; --line: 196 175 145;
                --font-display: "Literata", Georgia, serif;
                --font-body: "Literata", Georgia, serif;
                --font-mono: "JetBrains Mono", ui-monospace, monospace;
                --t-sky: #DCE0D8;    --e-sky: #B3BBAE;    --d-sky: #6F827C;
                --t-sage: #E0E1C8;   --e-sage: #BDBE96;   --d-sage: #7E8248;
                --t-butter: #F0DFB4; --e-butter: #D6BC7D; --d-butter: #B08A33;
                --t-rose: #ECD3C4;   --e-rose: #CFA894;   --d-rose: #A86A55;
                --t-lilac: #E2D5D6;  --e-lilac: #C0AAAE;  --d-lilac: #8E6F78;
                --t-paper: #F8F0E0;  --e-paper: #D9C7A8;  --d-paper: #A8916C;
                color-scheme: light;
            }

            /* Card colours pick up whichever theme they sit in */
            .tint-sky    { --tint: var(--t-sky);    --edge: var(--e-sky);    --dot: var(--d-sky); }
            .tint-sage   { --tint: var(--t-sage);   --edge: var(--e-sage);   --dot: var(--d-sage); }
            .tint-butter { --tint: var(--t-butter); --edge: var(--e-butter); --dot: var(--d-butter); }
            .tint-rose   { --tint: var(--t-rose);   --edge: var(--e-rose);   --dot: var(--d-rose); }
            .tint-lilac  { --tint: var(--t-lilac);  --edge: var(--e-lilac);  --dot: var(--d-lilac); }
            .tint-paper  { --tint: var(--t-paper);  --edge: var(--e-paper);  --dot: var(--d-paper); }

            body {
                background-color: rgb(var(--desk));
                background-image: radial-gradient(rgb(var(--ink) / 0.07) 1px, transparent 1px);
                background-size: 22px 22px;
            }

            /* Masonry board */
            .board { column-gap: 1.5rem; }
            .board > * { break-inside: avoid; margin-bottom: 1.5rem; }

            /* Signature: index cards resting slightly off-square, settling flat on hover */
            .note-card {
                background: var(--tint);
                border: 1px solid var(--edge);
                box-shadow: 0 1px 0 var(--edge), 0 10px 24px -14px rgb(27 42 58 / 0.35);
                transform: rotate(calc(var(--tilt, 0deg) * var(--tilt-scale, 1)));
                transition: transform 180ms ease, box-shadow 180ms ease;
            }
            .note-card:hover,
            .note-card:focus-within {
                transform: rotate(0deg) translateY(-3px);
                box-shadow: 0 1px 0 var(--edge), 0 18px 32px -16px rgb(27 42 58 / 0.45);
            }
            .note-card .card-actions { opacity: 0; transition: opacity 150ms ease; }
            .note-card:hover .card-actions,
            .note-card:focus-within .card-actions { opacity: 1; }
            @media (hover: none) { .note-card .card-actions { opacity: 1; } }

            .note-card.is-archived { opacity: 0.65; }
            .note-card.is-archived:hover { opacity: 1; }

            /* Timeline: one rail running down the page with a coloured dot per note */
            .timeline::before {
                content: '';
                position: absolute;
                top: 0.5rem;
                bottom: 0;
                left: calc(5.5rem + 5px);
                width: 2px;
                background: linear-gradient(to bottom, rgb(var(--ink) / 0.2), rgb(var(--ink) / 0.05));
            }
            @media (min-width: 640px) { .timeline::before { left: calc(7.5rem + 5px); } }
            .timeline-dot {
                position: absolute;
                left: 0;
                top: 1.45rem;
                width: 12px;
                height: 12px;
                border-radius: 9999px;
                background: var(--dot);
                box-shadow: 0 0 0 3px rgb(var(--desk));
            }

            mark.highlight {
                background: #FFE27A;
                color: #1B2A3A;
                padding: 0 2px;
                border-radius: 3px;
                text-shadow: none;
            }

            .swatch-dot { background: var(--tint); border: 1.5px solid var(--dot); }
            .swatch input:checked + .swatch-dot { box-shadow: 0 0 0 2px rgb(var(--desk)), 0 0 0 4px rgb(var(--pen)); }
            .swatch input:focus-visible + .swatch-dot { outline: 2px solid rgb(var(--pen)); outline-offset: 4px; }

            :focus-visible { outline: 2px solid rgb(var(--pen)); outline-offset: 2px; }

            .drawer { transition: transform 220ms ease; }
            .toast { transition: opacity 200ms ease, transform 200ms ease; }

            /* Theme picker previews: a tiny desk with two cards, drawn in that theme's own colours */
            .theme-preview { background: rgb(var(--desk)); color: rgb(var(--ink)); }
            .theme-preview .mini-card {
                position: absolute;
                width: 18px;
                height: 22px;
                border-radius: 3px;
                background: var(--tint);
                border: 1px solid var(--edge);
            }
            .theme-preview .mini-pen { background: rgb(var(--pen)); }
            .theme-preview .mini-text { font-family: var(--font-display); }

            /* ---------- Dark ---------- */
            html[data-theme="dark"] body { background-image: radial-gradient(rgb(255 255 255 / 0.05) 1px, transparent 1px); }
            html[data-theme="dark"] .note-card { box-shadow: 0 1px 0 var(--edge), 0 12px 28px -14px rgb(0 0 0 / 0.7); }
            html[data-theme="dark"] .note-card:hover,
            html[data-theme="dark"] .note-card:focus-within { box-shadow: 0 1px 0 var(--edge), 0 20px 36px -16px rgb(0 0 0 / 0.8); }

            /* ---------- Notebook ---------- */
            html[data-theme="notebook"] body {
                background-image:
                    repeating-linear-gradient(35deg, rgb(90 60 20 / 0.035) 0 2px, transparent 2px 5px),
                    repeating-linear-gradient(-55deg, rgb(255 255 255 / 0.05) 0 1px, transparent 1px 6px);
                background-size: auto;
            }
            html[data-theme="notebook"] .note-card {
                border-radius: 3px;
                padding-top: 1.75rem;
                padding-left: 2.75rem;
                background-color: var(--tint);
                /* red margin line + faint blue ruled lines, one every 1.75rem */
                background-image:
                    linear-gradient(90deg, transparent calc(2rem - 1px), rgb(214 80 80 / 0.55) calc(2rem - 1px), rgb(214 80 80 / 0.55) calc(2rem + 1px), transparent calc(2rem + 1px)),
                    repeating-linear-gradient(to bottom, transparent 0 calc(1.75rem - 1px), rgb(70 120 200 / 0.25) calc(1.75rem - 1px) 1.75rem);
                /* nudge the ruled lines up so writing sits on them rather than floating above */
                background-position: 0 0, 0 -0.3rem;
                box-shadow: inset 0 5px 0 var(--dot), 0 1px 0 var(--edge), 0 12px 24px -14px rgb(60 40 10 / 0.55);
            }
            html[data-theme="notebook"] .note-card:hover,
            html[data-theme="notebook"] .note-card:focus-within { box-shadow: inset 0 5px 0 var(--dot), 0 1px 0 var(--edge), 0 20px 32px -16px rgb(60 40 10 / 0.6); }
            /* Keep every row on the ruled lines */
            html[data-theme="notebook"] .note-card > * { margin-top: 0; margin-bottom: 0; }
            html[data-theme="notebook"] .card-meta { min-height: 1.75rem; line-height: 1.75rem; row-gap: 0; }
            html[data-theme="notebook"] .card-title { font-size: 1.4rem; line-height: 1.75rem; }
            html[data-theme="notebook"] .card-body p,
            html[data-theme="notebook"] .card-body .check-line { line-height: 1.75rem; padding-top: 0; padding-bottom: 0; }
            html[data-theme="notebook"] .card-body .check-line input { margin-top: 0.375rem; }
            html[data-theme="notebook"] .card-body .blank-line { height: 1.75rem; }
            html[data-theme="notebook"] .card-foot { min-height: 1.75rem; row-gap: 0.4rem; padding-top: 0.2rem; }
            html[data-theme="notebook"] .card-actions { top: 0.6rem; }
            html[data-theme="notebook"] #pageHeading { font-weight: 700; letter-spacing: -0.01em; }

            /* ---------- Retro ---------- */
            html[data-theme="retro"] body {
                background-image: linear-gradient(to bottom, #E9A23B 0 10px, #D9622B 10px 20px, #8C3B1F 20px 30px, transparent 30px);
                background-size: 100% 30px;
                background-repeat: no-repeat;
            }
            html[data-theme="retro"] .font-display { font-variation-settings: "SOFT" 100, "WONK" 1; font-weight: 900; letter-spacing: -0.01em; }
            html[data-theme="retro"] #pageHeading { text-shadow: 3px 3px 0 rgb(var(--pen)); }
            html[data-theme="retro"] .note-card {
                border: 2.5px solid rgb(var(--ink));
                border-radius: 1.25rem;
                box-shadow: 5px 5px 0 rgb(var(--ink));
            }
            html[data-theme="retro"] .note-card:hover,
            html[data-theme="retro"] .note-card:focus-within { transform: rotate(0deg) translate(-2px, -2px); box-shadow: 7px 7px 0 rgb(var(--ink)); }
            html[data-theme="retro"] .border-line { border-width: 2px; }
            html[data-theme="retro"] .timeline-dot { border: 2px solid rgb(var(--ink)); width: 14px; height: 14px; left: -1px; }

            /* ---------- Terminal ---------- */
            html[data-theme="terminal"] { --tilt-scale: 0; }
            html[data-theme="terminal"] body {
                background-image: radial-gradient(ellipse at center, rgb(40 90 50 / 0.18), transparent 70%);
                background-size: auto;
                background-attachment: fixed;
                text-shadow: 0 0 6px rgb(var(--ink) / 0.35);
            }
            /* Scanlines over the whole screen */
            html[data-theme="terminal"] body::after {
                content: '';
                position: fixed;
                inset: 0;
                pointer-events: none;
                z-index: 60;
                background: repeating-linear-gradient(to bottom, rgb(0 0 0 / 0.22) 0 1px, transparent 1px 3px);
            }
            /* A soft refresh band drifting down the screen */
            html[data-theme="terminal"] body::before {
                content: '';
                position: fixed;
                left: 0;
                right: 0;
                top: -25vh;
                height: 25vh;
                pointer-events: none;
                z-index: 61;
                background: linear-gradient(to bottom, transparent, rgb(110 255 150 / 0.04), transparent);
                animation: crt-scan 8s linear infinite;
            }
            @keyframes crt-scan { to { transform: translateY(150vh); } }
            html[data-theme="terminal"] main *,
            html[data-theme="terminal"] main *::after { border-radius: 0 !important; }
            html[data-theme="terminal"] .font-display { font-weight: 400; letter-spacing: 0.02em; }
            html[data-theme="terminal"] #pageHeading::before { content: '> '; color: rgb(var(--pen)); }
            html[data-theme="terminal"] #pageHeading::after { content: '_'; animation: cursor-blink 1.1s steps(1) infinite; }
            @keyframes cursor-blink { 50% { opacity: 0; } }
            html[data-theme="terminal"] .note-card { box-shadow: none; border-width: 1px; }
            html[data-theme="terminal"] .note-card:hover,
            html[data-theme="terminal"] .note-card:focus-within { transform: none; box-shadow: 0 0 0 1px var(--dot), 0 0 22px -6px var(--dot); }
            html[data-theme="terminal"] .card-title { color: var(--dot); font-size: 1.6rem; line-height: 1.9rem; }
            html[data-theme="terminal"] .card-body { font-size: 13.5px; }
            html[data-theme="terminal"] mark.highlight { background: rgb(var(--pen)); color: rgb(var(--desk)); }

            /* ---------- Blueprint ---------- */
            html[data-theme="blueprint"] { --tilt-scale: 0; }
            html[data-theme="blueprint"] body {
                background-image:
                    linear-gradient(rgb(255 255 255 / 0.10) 1px, transparent 1px),
                    linear-gradient(90deg, rgb(255 255 255 / 0.10) 1px, transparent 1px),
                    linear-gradient(rgb(255 255 255 / 0.04) 1px, transparent 1px),
                    linear-gradient(90deg, rgb(255 255 255 / 0.04) 1px, transparent 1px);
                background-size: 100px 100px, 100px 100px, 20px 20px, 20px 20px;
            }
            html[data-theme="blueprint"] .font-display { font-weight: 400; }
            html[data-theme="blueprint"] .note-card {
                border: 1.5px solid var(--edge);
                border-radius: 2px;
                box-shadow: inset 0 4px 0 var(--dot);
            }
            html[data-theme="blueprint"] .note-card:hover,
            html[data-theme="blueprint"] .note-card:focus-within { transform: translateY(-3px); box-shadow: inset 0 4px 0 var(--dot), 0 0 0 4px rgb(255 255 255 / 0.08); }

            /* ---------- Paperback ---------- */
            html[data-theme="paperback"] body {
                background-image: radial-gradient(ellipse at center, transparent 55%, rgb(120 80 40 / 0.16));
                background-size: auto;
                background-attachment: fixed;
            }
            html[data-theme="paperback"] .font-display { font-style: italic; font-weight: 700; }
            html[data-theme="paperback"] .note-card {
                border-radius: 4px;
                box-shadow: 0 1px 2px rgb(80 50 20 / 0.15), 0 10px 22px -14px rgb(80 50 20 / 0.4);
            }
            html[data-theme="paperback"] .note-card:hover,
            html[data-theme="paperback"] .note-card:focus-within { box-shadow: 0 1px 2px rgb(80 50 20 / 0.15), 0 18px 30px -16px rgb(80 50 20 / 0.5); }

            @media (prefers-reduced-motion: reduce) {
                .note-card, .drawer, .toast, .card-actions { transition: none !important; }
                .note-card, .note-card:hover { transform: none !important; }
                html[data-theme="terminal"] body::before { display: none; }
                html[data-theme="terminal"] #pageHeading::after { animation: none; }
            }
        </style>
    </head>
    <body class="text-ink font-sans min-h-screen flex flex-col antialiased">
        <main class="flex-grow w-full">
            <%- body %>
        </main>
    </body>
</html>
