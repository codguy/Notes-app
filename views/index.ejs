<%
  const chip = 'tag-chip rounded-full border px-3 py-1 text-sm font-semibold transition-colors';
  const chipOn = 'border-ink bg-ink text-white';
  const chipOff = 'border-slate-300 bg-white/70 text-ink hover:border-pen hover:text-pen';
  const segment = 'view-btn inline-flex items-center gap-1.5 rounded-full px-3.5 py-1.5 text-sm font-semibold';
%>
<header class="max-w-6xl mx-auto px-5 pt-8 sm:pt-12">
  <div class="flex items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2.5">
      <span class="grid h-9 w-9 place-items-center rounded-lg bg-ink text-white font-display font-extrabold text-lg rotate-[-4deg]">N</span>
      <span class="font-display text-xl font-bold tracking-tight">Notes</span>
    </a>
    <button type="button" id="archiveButton"
      class="inline-flex items-center gap-2 rounded-full border border-slate-300 bg-white/70 px-4 py-2 text-sm font-semibold hover:border-pen hover:text-pen">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" /></svg>
      Archive
      <span class="rounded-full bg-ink px-2 py-0.5 font-mono text-[11px] text-white"><%= counts.archived %></span>
    </button>
  </div>

  <div class="mt-12 sm:mt-16 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
    <div>
      <h1 id="pageHeading" class="font-display text-4xl sm:text-6xl font-extrabold tracking-tight leading-none"><%= prefs.view === 'timeline' ? 'Your timeline' : 'Your board' %></h1>
      <p class="mt-3 font-mono text-xs uppercase tracking-wider text-slate">
        <%= counts.notes %> <%= counts.notes === 1 ? 'note' : 'notes' %> · <%= counts.pinned %> pinned · <%= counts.archived %> archived
      </p>
    </div>
    <div class="relative w-full md:max-w-sm">
      <label for="searchInput" class="sr-only">Search notes</label>
      <svg xmlns="http://www.w3.org/2000/svg" class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 h-5 w-5 text-slate" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
      <input type="search" id="searchInput" placeholder="Search titles, text and tags" autocomplete="off" value="<%= searchTerm %>"
        class="w-full rounded-full border border-slate-300 bg-white py-3 pl-11 pr-14 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-pen focus:border-transparent">
      <kbd class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 rounded border border-slate-300 px-1.5 font-mono text-[11px] text-slate">/</kbd>
    </div>
  </div>

  <!-- View, sort and archive controls -->
  <div class="mt-8 flex flex-wrap items-center gap-3">
    <div role="group" aria-label="View" class="inline-flex rounded-full border border-slate-300 bg-white/70 p-1">
      <button type="button" data-view="board" aria-pressed="<%= prefs.view === 'board' %>"
        class="<%= segment %> <%= prefs.view === 'board' ? 'bg-ink text-white' : 'text-ink hover:text-pen' %>">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5h6v6H4zM14 5h6v4h-6zM14 13h6v6h-6zM4 15h6v4H4z" /></svg>
        Board
      </button>
      <button type="button" data-view="timeline" aria-pressed="<%= prefs.view === 'timeline' %>"
        class="<%= segment %> <%= prefs.view === 'timeline' ? 'bg-ink text-white' : 'text-ink hover:text-pen' %>">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 3v18M6 7h.01M6 12h.01M6 17h.01M10 7h10M10 12h7M10 17h9" /></svg>
        Timeline
      </button>
    </div>

    <label id="sortControl" class="<%= prefs.view === 'timeline' ? 'hidden' : 'inline-flex' %> items-center gap-2 rounded-full border border-slate-300 bg-white/70 py-1 pl-4 pr-2 text-sm font-semibold">
      Sort
      <select id="sortSelect" class="rounded-full bg-transparent py-1 pr-1 font-semibold text-pen focus:outline-none">
        <option value="newest" <%= prefs.sort === 'newest' ? 'selected' : '' %>>Newest first</option>
        <option value="oldest" <%= prefs.sort === 'oldest' ? 'selected' : '' %>>Oldest first</option>
        <option value="edited" <%= prefs.sort === 'edited' ? 'selected' : '' %>>Recently edited</option>
        <option value="az" <%= prefs.sort === 'az' ? 'selected' : '' %>>A to Z</option>
      </select>
    </label>

    <label class="inline-flex cursor-pointer items-center gap-2.5 rounded-full border border-slate-300 bg-white/70 py-1.5 pl-2 pr-4 text-sm font-semibold">
      <input type="checkbox" id="showArchived" class="peer sr-only" <%= prefs.showArchived ? 'checked' : '' %>>
      <span class="relative h-5 w-9 rounded-full bg-slate-400 transition-colors peer-checked:bg-pen after:absolute after:content-[''] after:left-0.5 after:top-0.5 after:h-4 after:w-4 after:rounded-full after:bg-white after:transition-transform peer-checked:after:translate-x-4 peer-focus-visible:ring-2 peer-focus-visible:ring-pen"></span>
      Include archived
    </label>
  </div>

  <% if (tags.length) { %>
    <div class="mt-4 flex flex-wrap items-center gap-2" aria-label="Filter by tag">
      <button type="button" data-tag="" class="<%= chip %> <%= !activeTag ? chipOn : chipOff %>">All notes</button>
      <% tags.forEach(function([tag, count]) { %>
        <button type="button" data-tag="<%= tag %>" class="<%= chip %> <%= activeTag === tag ? chipOn : chipOff %>">
          #<%= tag %> <span class="ml-0.5 font-mono text-[11px] opacity-60"><%= count %></span>
        </button>
      <% }); %>
    </div>
  <% } %>
</header>

<section class="max-w-6xl mx-auto px-5 pt-10 pb-32">
  <div id="notesList">
    <%- include('notes.ejs') %>
  </div>
</section>

<!-- New / edit note dialog -->
<div id="createNoteModal" class="fixed z-30 inset-0 hidden overflow-y-auto" role="dialog" aria-modal="true" aria-labelledby="noteFormHeading">
  <div class="fixed inset-0 bg-ink/40 backdrop-blur-sm" data-close-modal></div>
  <div class="relative mx-auto my-[6vh] w-[calc(100%-2rem)] max-w-lg rounded-2xl bg-desk p-6 sm:p-8 shadow-2xl">
    <button type="button" data-close-modal aria-label="Close" class="absolute top-4 right-4 p-1.5 rounded-md text-slate hover:text-ink hover:bg-white">
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
    </button>
    <%- include('create.ejs') %>
  </div>
</div>

<!-- Archive drawer -->
<div id="archiveList" class="fixed z-30 inset-0 hidden" role="dialog" aria-modal="true" aria-labelledby="archiveHeading">
  <div class="absolute inset-0 bg-ink/40 backdrop-blur-sm" data-close-archive></div>
  <aside class="drawer absolute right-0 top-0 h-full w-full max-w-md translate-x-full overflow-y-auto bg-desk p-6 sm:p-8 shadow-2xl">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h2 id="archiveHeading" class="font-display text-2xl font-bold">Archive</h2>
        <p class="text-sm text-slate">Notes you've put away. Restore one to bring it back to your board.</p>
      </div>
      <button type="button" data-close-archive aria-label="Close archive" class="self-start p-1.5 rounded-md text-slate hover:text-ink hover:bg-white">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>
    <%- include('archived-notes.ejs', {archived: archived}) %>
  </aside>
</div>

<button type="button" id="openCreateModal"
  class="fixed z-20 bottom-6 right-6 sm:bottom-8 sm:right-8 inline-flex items-center gap-2 rounded-full bg-pen px-5 py-3.5 font-semibold text-white shadow-lg shadow-blue-900/25 hover:bg-blue-700">
  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" /></svg>
  New note
</button>

<div id="toast" role="status" aria-live="polite"
  class="toast pointer-events-none fixed bottom-6 left-1/2 z-40 flex -translate-x-1/2 translate-y-2 items-center gap-4 rounded-full bg-ink py-2.5 pl-5 pr-3 text-sm font-semibold text-white opacity-0 shadow-lg">
  <span id="toastMessage"></span>
  <button type="button" id="toastAction" class="hidden rounded-full px-3 py-1 font-bold text-[#9DB8FF] hover:bg-white/10"></button>
</div>

<script>
  const modal = document.getElementById('createNoteModal');
  const noteForm = document.getElementById('noteForm');
  const formHeading = document.getElementById('noteFormHeading');
  const formSubmit = document.getElementById('noteFormSubmit');
  const archiveList = document.getElementById('archiveList');
  const drawer = archiveList.querySelector('.drawer');
  const searchInput = document.getElementById('searchInput');
  const notesList = document.getElementById('notesList');
  const toast = document.getElementById('toast');
  const toastMessage = document.getElementById('toastMessage');
  const toastAction = document.getElementById('toastAction');

  // Current filters live in the address bar so they survive reloads
  const state = {
    term: searchInput.value,
    tag: new URLSearchParams(location.search).get('tag') || '',
  };

  // ---- Preferences (view, sort, archived) are saved in cookies ----
  function setPref(name, value) {
    document.cookie = `${name}=${encodeURIComponent(value)}; path=/; max-age=31536000; samesite=lax`;
  }
  function getCookie(name) {
    const match = document.cookie.split('; ').find(part => part.startsWith(name + '='));
    return match ? decodeURIComponent(match.split('=')[1]) : null;
  }
  // Dates are shown in this browser's timezone; reload once if the server didn't know it yet
  const tz = String(-new Date().getTimezoneOffset());
  if (getCookie('tz') !== tz) {
    setPref('tz', tz);
    if (getCookie('tz') === tz && !sessionStorage.getItem('tzReloaded')) {
      sessionStorage.setItem('tzReloaded', '1');
      location.reload();
    }
  }

  // ---- Toasts (survive the page reload after an action) ----
  function showToast(message, action) {
    toastMessage.textContent = message;
    if (action) {
      toastAction.textContent = action.label;
      toastAction.onclick = action.run;
      toastAction.classList.remove('hidden');
      toast.classList.remove('pointer-events-none');
    } else {
      toastAction.classList.add('hidden');
      toast.classList.add('pointer-events-none');
    }
    toast.classList.remove('opacity-0', 'translate-y-2');
    clearTimeout(showToast.timer);
    showToast.timer = setTimeout(() => {
      toast.classList.add('opacity-0', 'translate-y-2', 'pointer-events-none');
    }, action ? 7000 : 2600);
  }
  function reloadWithToast(message, extra) {
    sessionStorage.setItem('toast', JSON.stringify({ message, ...extra }));
    location.reload();
  }
  const pendingToast = sessionStorage.getItem('toast');
  if (pendingToast) {
    sessionStorage.removeItem('toast');
    let data;
    try { data = JSON.parse(pendingToast); } catch (e) { data = { message: pendingToast }; }
    if (data.undoDelete) {
      showToast(data.message, { label: 'Undo', run: () => restoreNote(data.undoDelete) });
    } else {
      showToast(data.message);
    }
  }

  // ---- New / edit dialog ----
  function openModal() {
    modal.classList.remove('hidden');
    document.body.classList.add('overflow-hidden');
    setTimeout(() => noteForm.title.focus(), 0);
  }
  function closeModal() {
    modal.classList.add('hidden');
    document.body.classList.remove('overflow-hidden');
  }
  function openCreate() {
    noteForm.reset();
    noteForm.action = '/create';
    noteForm.tags.value = state.tag; // new notes inherit the tag you're looking at
    formHeading.textContent = 'New note';
    formSubmit.textContent = 'Save note';
    noteForm.dataset.toast = 'Note saved';
    openModal();
  }
  function editNote(id) {
    const card = notesList.querySelector(`[data-id="${id}"]`);
    if (!card) return;
    noteForm.action = '/update/' + id;
    noteForm.title.value = card.dataset.title;
    noteForm.content.value = card.dataset.content;
    noteForm.tags.value = card.dataset.tags;
    const swatch = noteForm.querySelector(`input[name="color"][value="${card.dataset.color}"]`);
    if (swatch) swatch.checked = true;
    formHeading.textContent = 'Edit note';
    formSubmit.textContent = 'Save changes';
    noteForm.dataset.toast = 'Changes saved';
    openModal();
  }
  noteForm.addEventListener('submit', () => {
    sessionStorage.setItem('toast', JSON.stringify({ message: noteForm.dataset.toast || 'Note saved' }));
  });
  document.getElementById('openCreateModal').addEventListener('click', openCreate);
  modal.querySelectorAll('[data-close-modal]').forEach(el => el.addEventListener('click', closeModal));

  // Adds "[ ] " at the start of the current line (or a new line) in the note text
  document.getElementById('addChecklistItem').addEventListener('click', () => {
    const box = noteForm.content;
    const pos = box.selectionStart;
    const before = box.value.slice(0, pos);
    const atLineStart = before === '' || before.endsWith('\n');
    const insert = (atLineStart ? '' : '\n') + '[ ] ';
    box.setRangeText(insert, pos, box.selectionEnd, 'end');
    box.focus();
  });

  // ---- Archive drawer ----
  function openArchive() {
    archiveList.classList.remove('hidden');
    document.body.classList.add('overflow-hidden');
    requestAnimationFrame(() => requestAnimationFrame(() => drawer.classList.remove('translate-x-full')));
  }
  function closeArchive() {
    drawer.classList.add('translate-x-full');
    document.body.classList.remove('overflow-hidden');
    setTimeout(() => archiveList.classList.add('hidden'), 220);
  }
  document.getElementById('archiveButton').addEventListener('click', openArchive);
  archiveList.querySelectorAll('[data-close-archive]').forEach(el => el.addEventListener('click', closeArchive));

  // ---- Note actions ----
  function noteAction(url, method, failMessage, onSuccess) {
    fetch(url, { method })
      .then(response => response.json())
      .then(data => data.success ? onSuccess(data) : showToast(data.message || failMessage))
      .catch(() => showToast(failMessage));
  }
  function deleteNote(id) {
    noteAction(`/delete/${id}`, 'DELETE', 'Couldn’t delete the note. Try again.',
      () => reloadWithToast('Note deleted', { undoDelete: id }));
  }
  function restoreNote(id) {
    noteAction(`/restore/${id}`, 'POST', 'Couldn’t bring the note back. Try again.',
      () => reloadWithToast('Note restored'));
  }
  function archiveNote(id) {
    noteAction(`/archive/${id}`, 'POST', 'Couldn’t archive the note. Try again.',
      () => reloadWithToast('Note archived'));
  }
  function unarchiveNote(id) {
    noteAction(`/unarchive/${id}`, 'POST', 'Couldn’t restore the note. Try again.',
      () => reloadWithToast('Note restored to your board'));
  }
  function pinNote(id) {
    noteAction(`/pin/${id}`, 'POST', 'Couldn’t pin the note. Try again.',
      data => reloadWithToast(data.pinned ? 'Note pinned to the top' : 'Note unpinned'));
  }

  // Tick a checklist item without reloading the page
  function toggleItem(id, line, checkbox) {
    const label = checkbox.nextElementSibling;
    fetch(`/toggle/${id}/${line}`, { method: 'POST' })
      .then(response => response.json())
      .then(data => {
        if (!data.success) throw new Error(data.message);
        label.classList.toggle('line-through', data.checked);
        label.classList.toggle('text-slate', data.checked);
        checkbox.closest('.note-card').dataset.content = data.content;
      })
      .catch(() => {
        checkbox.checked = !checkbox.checked;
        showToast('That note changed somewhere else. Showing the latest version.');
        refreshNotes();
      });
  }

  // ---- Refreshing the list: search, tags, view and sort ----
  function escapeHtml(text) {
    return text.replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  }
  function highlightSearchTerm(term) {
    if (!term) return;
    const regex = new RegExp(escapeHtml(term).replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'gi');
    notesList.querySelectorAll('.hl').forEach(element => {
      element.innerHTML = escapeHtml(element.textContent).replace(regex, match => `<mark class="highlight">${match}</mark>`);
    });
  }
  function currentQuery() {
    const params = new URLSearchParams();
    if (state.term) params.set('term', state.term);
    if (state.tag) params.set('tag', state.tag);
    return params.toString();
  }
  let latestRequest = 0;
  function refreshNotes() {
    const query = currentQuery();
    const requestId = ++latestRequest;
    history.replaceState(null, '', query ? `/?${query}` : '/');
    return fetch(`/notes?${query}`)
      .then(response => response.text())
      .then(html => {
        if (requestId !== latestRequest) return; // a newer request has started
        notesList.innerHTML = html;
        highlightSearchTerm(state.term);
      })
      .catch(() => showToast('Couldn’t load your notes. Try again.'));
  }

  let searchTimer;
  searchInput.addEventListener('input', () => {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(() => {
      state.term = searchInput.value.trim();
      refreshNotes();
    }, 250);
  });
  highlightSearchTerm(state.term);

  function filterTag(tag) {
    state.tag = state.tag === tag ? '' : tag;
    document.querySelectorAll('.tag-chip').forEach(chip => {
      const on = chip.dataset.tag === state.tag;
      chip.classList.toggle('bg-ink', on);
      chip.classList.toggle('text-white', on);
      chip.classList.toggle('border-ink', on);
      chip.classList.toggle('bg-white/70', !on);
      chip.classList.toggle('border-slate-300', !on);
    });
    refreshNotes();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }
  document.querySelectorAll('.tag-chip').forEach(chip => {
    chip.addEventListener('click', () => filterTag(chip.dataset.tag));
  });

  function setView(view) {
    setPref('view', view);
    document.querySelectorAll('[data-view]').forEach(button => {
      const on = button.dataset.view === view;
      button.setAttribute('aria-pressed', on);
      button.classList.toggle('bg-ink', on);
      button.classList.toggle('text-white', on);
      button.classList.toggle('text-ink', !on);
    });
    document.getElementById('pageHeading').textContent = view === 'timeline' ? 'Your timeline' : 'Your board';
    const sortControl = document.getElementById('sortControl');
    sortControl.classList.toggle('hidden', view === 'timeline');
    sortControl.classList.toggle('inline-flex', view !== 'timeline');
    refreshNotes();
  }
  document.querySelectorAll('[data-view]').forEach(button => {
    button.addEventListener('click', () => setView(button.dataset.view));
  });

  document.getElementById('sortSelect').addEventListener('change', (e) => {
    setPref('sort', e.target.value);
    refreshNotes();
  });

  // Tag list and counts change when archived notes are included, so reload the page
  document.getElementById('showArchived').addEventListener('change', (e) => {
    setPref('showArchived', e.target.checked ? '1' : '0');
    location.reload();
  });

  // ---- Keyboard shortcuts ----
  document.addEventListener('keydown', (e) => {
    const typing = ['INPUT', 'TEXTAREA', 'SELECT'].includes(document.activeElement.tagName);
    if (e.key === 'Escape') {
      if (!modal.classList.contains('hidden')) closeModal();
      else if (!archiveList.classList.contains('hidden')) closeArchive();
      else if (document.activeElement === searchInput && searchInput.value) {
        searchInput.value = '';
        state.term = '';
        refreshNotes();
      }
      return;
    }
    if (typing || e.ctrlKey || e.metaKey || e.altKey || !modal.classList.contains('hidden')) return;
    if (e.key === '/') {
      e.preventDefault();
      searchInput.focus();
    } else if (e.key === 'n') {
      e.preventDefault();
      openCreate();
    } else if (e.key === 'b') {
      setView('board');
    } else if (e.key === 't') {
      setView('timeline');
    }
  });
</script>
