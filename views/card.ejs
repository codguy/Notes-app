<%
  // One note card. Used by both the board and the timeline.
  // Expects: note, h (helpers), prefs, now, variant ('board' | 'timeline'), tilt
  const tz = prefs.tzOffset;
  const lines = h.noteLines(note.content);
  const progress = h.checklistProgress(note.content);
  const tags = note.tags || [];
  const iconBtn = 'p-1.5 rounded-md text-slate hover:bg-white/70';
%>
<article
  class="note-card tint-<%= h.tintFor(note) %> relative rounded-xl px-6 pt-5 pb-5<%= note.archived ? ' is-archived' : '' %>"
  style="--tilt: <%= variant === 'board' ? tilt : '0deg' %>"
  data-id="<%= note.id %>"
  data-title="<%= note.title %>"
  data-content="<%= note.content %>"
  data-color="<%= h.tintFor(note) %>"
  data-tags="<%= tags.join(', ') %>"
>
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mb-2 min-h-[18px] pr-28 whitespace-nowrap font-mono text-[11px] uppercase tracking-wider text-slate">
    <% if (variant === 'board') { %><span><%= h.formatDate(note.id, tz) %></span><% } %>
    <% if (note.pinned && !note.archived) { %>
      <span class="inline-flex items-center gap-1 text-pen" title="Pinned">
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" /></svg>
        Pinned
      </span>
    <% } %>
    <% if (note.archived) { %><span class="rounded bg-ink/10 px-1.5 py-0.5 text-ink">Archived</span><% } %>
    <% if (progress.total) { %><span title="Checklist progress"><%= progress.done %>/<%= progress.total %> done</span><% } %>
  </div>

  <h3 class="hl font-display font-bold text-xl leading-snug"><%= note.title %></h3>

  <div class="mt-2 text-[15px] leading-relaxed text-ink/80">
    <% lines.forEach(function(line) { %>
      <% if (line.type === 'check') { %>
        <label class="check-line flex items-start gap-2.5 py-0.5 cursor-pointer">
          <input type="checkbox" class="mt-1 h-4 w-4 shrink-0 rounded accent-[#2F5BEA]" <%= line.checked ? 'checked' : '' %>
            onchange="toggleItem('<%= note.id %>', <%= line.index %>, this)">
          <span class="hl<%= line.checked ? ' line-through text-slate' : '' %>"><%= line.text %></span>
        </label>
      <% } else if (line.type === 'text') { %>
        <p class="hl break-words"><%= line.text %></p>
      <% } else { %>
        <div class="h-3"></div>
      <% } %>
    <% }); %>
  </div>

  <% if (tags.length || (variant === 'board' && h.wasEdited(note))) { %>
    <div class="mt-4 flex flex-wrap items-center gap-1.5">
      <% tags.forEach(function(tag) { %>
        <button type="button" data-tag="<%= tag %>" onclick="filterTag(this.dataset.tag)"
          class="rounded-full bg-white/60 px-2.5 py-0.5 text-xs font-semibold text-ink/70 hover:bg-white hover:text-pen">#<%= tag %></button>
      <% }); %>
      <% if (variant === 'board' && h.wasEdited(note)) { %>
        <span class="ml-auto font-mono text-[11px] text-slate">Edited <%= h.timeAgo(note.updatedAt, now) %></span>
      <% } %>
    </div>
  <% } %>

  <div class="card-actions absolute top-3 right-3 flex gap-0.5">
    <% if (note.archived) { %>
      <button type="button" onclick="unarchiveNote('<%= note.id %>')" title="Restore to board" aria-label="Restore note: <%= note.title %>" class="<%= iconBtn %> hover:text-pen">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6" /></svg>
      </button>
    <% } else { %>
      <button type="button" onclick="pinNote('<%= note.id %>')" title="<%= note.pinned ? 'Unpin note' : 'Pin to top' %>" aria-label="<%= note.pinned ? 'Unpin' : 'Pin' %> note: <%= note.title %>"
        class="<%= iconBtn %> <%= note.pinned ? 'text-pen' : '' %> hover:text-pen">
        <svg class="h-4 w-4" fill="<%= note.pinned ? 'currentColor' : 'none' %>" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" /></svg>
      </button>
      <button type="button" onclick="editNote('<%= note.id %>')" title="Edit note" aria-label="Edit note: <%= note.title %>" class="<%= iconBtn %> hover:text-pen">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
      </button>
      <button type="button" onclick="archiveNote('<%= note.id %>')" title="Archive note" aria-label="Archive note: <%= note.title %>" class="<%= iconBtn %> hover:text-pen">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" /></svg>
      </button>
    <% } %>
    <button type="button" onclick="deleteNote('<%= note.id %>')" title="Delete note" aria-label="Delete note: <%= note.title %>" class="<%= iconBtn %> hover:text-red-600">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
    </button>
  </div>
</article>
